# ─────────────────────────────────────────────────────────────────────────────
# Local development environment variables.
# Copy this file to .env and fill in your real values.
#
# For Vercel production: add ALL variables below to:
#   Vercel Dashboard → Project → Settings → Environment Variables
# Do NOT prefix with VITE_ — these are server-side only (serverless function).
# ─────────────────────────────────────────────────────────────────────────────

# Express local dev server port
PORT=5000

# ── Gmail SMTP (works with a Gmail App Password) ─────────────────────────────
# Port 587 + SMTP_SECURE=false → STARTTLS (recommended)
# Port 465 + SMTP_SECURE=true  → SSL/TLS (alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Gmail account used to SEND emails (must have an App Password generated)
SMTP_USER=your-gmail@gmail.com

# Gmail App Password (16-char, generated at myaccount.google.com/apppasswords)
# NEVER use your normal Gmail password here.
SMTP_PASSWORD=your-16-char-app-password

# Email address that receives the contact form submissions
CONTACT_RECEIVER=your-gmail@gmail.com

# (Local dev only) Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173
